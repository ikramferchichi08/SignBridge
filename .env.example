# Optional local or remote MLflow tracking URI.
MLFLOW_TRACKING_URI=file:./mlruns

# Optional first-run administrator account. Use a private password of at least
# 12 characters; do not commit real values.
SIGNBRIDGE_ADMIN_EMAIL=
SIGNBRIDGE_ADMIN_PASSWORD=

# SQLite defaults to data/signbridge.sqlite3. Enable secure cookies behind HTTPS.
SIGNBRIDGE_DB_PATH=data/signbridge.sqlite3
SIGNBRIDGE_COOKIE_SECURE=false

# Set these only when using a configured remote; never commit real credentials.
# DAGSHUB_USERNAME=
# DAGSHUB_TOKEN=
